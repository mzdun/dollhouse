# Hardening. The flags depending on the configuration are generator
# expressions, as Visual Studio picks the configuration at build time.
set(_dollhouse_optimized "$<NOT:$<CONFIG:Debug>>")
if (MSVC)
  # Control Flow Guard; incremental linking of Debug builds does not go with it
  list(APPEND DOLLHOUSE_ADDITIONAL_COMPILE_FLAGS "$<${_dollhouse_optimized}:/guard:cf>")
  list(APPEND DOLLHOUSE_ADDITIONAL_LINK_FLAGS "$<${_dollhouse_optimized}:/guard:cf>")
else()
  include(CheckCXXCompilerFlag)
  list(APPEND DOLLHOUSE_ADDITIONAL_COMPILE_FLAGS -fstack-protector-strong)
  # turns a stack overflow into a crash, instead of a jump over the guard page
  check_cxx_compiler_flag(-fstack-clash-protection DOLLHOUSE_HAS_STACK_CLASH_PROTECTION)
  if (DOLLHOUSE_HAS_STACK_CLASH_PROTECTION)
    list(APPEND DOLLHOUSE_ADDITIONAL_COMPILE_FLAGS -fstack-clash-protection)
  endif()
  if (CMAKE_SYSTEM_NAME STREQUAL "Linux")
    # needs optimizations, and gets in the way of the ASan interceptors; the
    # toolchain may define it already (Ubuntu does), hence -U first, or the
    # redefinition warns
    if (NOT DOLLHOUSE_SANITIZE)
      list(APPEND DOLLHOUSE_ADDITIONAL_COMPILE_FLAGS
        "$<${_dollhouse_optimized}:-U_FORTIFY_SOURCE>"
        "$<${_dollhouse_optimized}:-D_FORTIFY_SOURCE=3>"
      )
    endif()
    list(APPEND DOLLHOUSE_ADDITIONAL_LINK_FLAGS -Wl,-z,relro,-z,now)
  endif()
  # checks of the standard library (bounds of operator[], front() of an
  # empty container, ...); each library ignores the macro of the other one
  list(APPEND DOLLHOUSE_ADDITIONAL_COMPILE_FLAGS
    "$<$<CONFIG:Debug>:-D_GLIBCXX_ASSERTIONS>"
    "$<$<CONFIG:Debug>:-D_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_DEBUG>"
  )
endif()
unset(_dollhouse_optimized)

# Sets OUT_VAR to the environment (a list of NAME=value) a Python interpreter
# needs to load a module of this build.
#
# With sanitizers on, the module links the ASan runtime, but the interpreter
# loading it does not. ASan has to be the first library in the process, so it
# is preloaded; libstdc++ is preloaded with it, or ASan's __cxa_throw
# interceptor stays unresolved in the (C-only) interpreter and the first C++
# exception aborts the process. Leak detection is off, as CPython does not
# free everything at exit.
function(dollhouse_python_env OUT_VAR)
  set(result)
  if(DOLLHOUSE_SANITIZE AND CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    set(preload)
    foreach(lib libasan.so libstdc++.so)
      execute_process(
        COMMAND ${CMAKE_CXX_COMPILER} -print-file-name=${lib}
        OUTPUT_VARIABLE lib_path
        OUTPUT_STRIP_TRAILING_WHITESPACE
      )
      list(APPEND preload ${lib_path})
    endforeach()
    list(JOIN preload " " preload)
    list(APPEND result "LD_PRELOAD=${preload}" "ASAN_OPTIONS=detect_leaks=0")
  endif()
  set(${OUT_VAR} ${result} PARENT_SCOPE)
endfunction()

# Copies the ASan runtime next to the binary of TARGET after each build.
#
# With sanitizers on, MSVC links every binary against the dynamic ASan
# runtime, which lives next to cl.exe and is not on the search path of a
# process started outside of a developer prompt. Python (3.8+) does not
# search PATH for the dependencies of an extension module at all, only the
# module's own directory, so the runtime has to be copied there.
function(dollhouse_copy_asan_runtime TARGET)
  if(NOT (DOLLHOUSE_SANITIZE AND MSVC))
    return()
  endif()
  get_filename_component(compiler_dir "${CMAKE_CXX_COMPILER}" DIRECTORY)
  file(GLOB runtime "${compiler_dir}/clang_rt.asan_dynamic-*.dll")
  if(NOT runtime)
    message(FATAL_ERROR "ASan runtime not found in ${compiler_dir}")
  endif()
  add_custom_command(TARGET ${TARGET} POST_BUILD
    COMMAND ${CMAKE_COMMAND} -E copy_if_different ${runtime} $<TARGET_FILE_DIR:${TARGET}>
    VERBATIM
  )
endfunction()

# Describes the build of the Python module TARGET in OUTPUT, a JSON file
# (see variant.cmake), refreshed on each build, so it follows new commits
# and local changes even when TARGET itself is up to date.
function(dollhouse_module_variant TARGET OUTPUT)
  find_package(Git QUIET)
  if(DOLLHOUSE_SANITIZE)
    set(sanitizer ON)
  else()
    set(sanitizer OFF)
  endif()
  if(DOLLHOUSE_FREE_THREADED)
    set(free_threaded ON)
  else()
    set(free_threaded OFF)
  endif()
  add_custom_target(${TARGET}-variant ALL
    COMMAND ${CMAKE_COMMAND}
      -DOUTPUT=${OUTPUT}
      -DBINARY=$<TARGET_FILE_NAME:${TARGET}>
      -DBUILD_TYPE=$<CONFIG>
      -DSANITIZER=${sanitizer}
      -DFREE_THREADED=${free_threaded}
      "-DCOMPILER=${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}"
      -DSYSTEM=${CMAKE_SYSTEM_NAME}
      -DSOURCE_DIR=${PROJECT_SOURCE_DIR}
      -DGIT=${GIT_EXECUTABLE}
      -P ${PROJECT_SOURCE_DIR}/.flow/cmake/variant.cmake
    BYPRODUCTS ${OUTPUT}
    COMMENT "Describing the build of ${TARGET}"
    VERBATIM
  )
  add_dependencies(${TARGET}-variant ${TARGET})
  set_target_properties(${TARGET}-variant PROPERTIES FOLDER apps)
endfunction()
